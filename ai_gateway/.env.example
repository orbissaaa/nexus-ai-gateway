# Optional protection for clients calling your gateway.
GATEWAY_API_KEY=replace-with-a-long-random-client-key

HOST=0.0.0.0
PORT=8000
REQUEST_TIMEOUT=60
COOLDOWN_SECONDS=86400

# Configure only API keys that you own or are explicitly authorized to use.
# Repeat the block for PROVIDER_2_ through PROVIDER_100_ as needed.
PROVIDER_1_NAME=groq
PROVIDER_1_KEY=replace-with-your-provider-key
PROVIDER_1_MODEL=llama-3.1-8b-instant
PROVIDER_1_BASE_URL=https://api.groq.com/openai/v1

# Example OpenAI-compatible provider:
# PROVIDER_2_NAME=openrouter
# PROVIDER_2_KEY=replace-with-your-provider-key
# PROVIDER_2_MODEL=openai/gpt-4o-mini
# PROVIDER_2_BASE_URL=https://openrouter.ai/api/v1
